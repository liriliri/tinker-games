{
  "name": "tinker-sudoku",
  "version": "0.1.0",
  "description": "Sudoku Game Plugin for TINKER",
  "files": [
    "dist/",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/tinker-games.git"
  },
  "tinker": {
    "name": "Sudoku",
    "description": "Fill the grid so every row, column, and box contains 1–9.",
    "main": "dist/index.html",
    "icon": "icon.png",
    "locales": {
      "zh-CN": {
        "name": "数独",
        "description": "在九宫格中填入 1–9，使每行、每列、每个宫格都不重复。"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "format": "prettier \"src/**/*.ts\" \"*.{html,json,ts}\" --write"
  }
}
